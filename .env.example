# SECRETOS. No van en git ni en config.local.json. Cópialos a mano a %USERPROFILE%\.config\ (valores TUYOS, nunca los de otra persona).
#
# --- ~/.config/canal-slack.env (lo leen la escucha, la oficina y los scripts) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_WEBHOOK_CANAL=
SLACK_CANAL_ID=
SLACK_HUMANO_ID=
SLACK_CLAUDE_ID=
SLACK_COO_ID=
SLACK_CURSOR_ID=
CURSOR_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
# COO_WEBHOOK_KEY: la clave Bearer de POST /api/coo/publicar (oficina y pasarela del túnel); si falta, vale GROK_WEBHOOK_KEY
COO_WEBHOOK_KEY=
# Túnel HTTPS de Coo (herramientas/tunel-coo.js). Vacíos = quick tunnel de trycloudflare.com (la URL cambia al reiniciar).
# Con URL fija: el token del Named Tunnel de Cloudflare y su URL pública (https://coo.tudominio.com). SETUP.md, paso 11.
CLOUDFLARE_TUNNEL_TOKEN=
COO_TUNNEL_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
#
# --- ~/.config/oficina-slack.env (fichero aparte; las IAs no lo leen) ---
# SLACK_USER_TOKEN=
#
# --- ~/.config/oficina-calendario.env (opcional) ---
# CALENDARIO_CANAL=
#
# --- ~/.config/mulesoft.env (solo si te dan acceso; Connected App de SOLO lectura) ---
# MULE_CLIENT_ID=
# MULE_CLIENT_SECRET=
SLACK_USER_TOKEN=
MULE_CLIENT_ID=
MULE_CLIENT_SECRET=
MULE_ORG_ID=
MULE_HOST=
